# Names and types recovered for JWLTHIEF.EXE v1.4, applied by
# tools/ghidra/scripts/ApplySymbols.java. Our own knowledge, not original code.
#
# struct NAME  TYPE member, TYPE member[N], ...
# fn     ADDR  NAME                          # comment
# var    ADDR  NAME  TYPE                    # comment
#
# Types are Win16Api types (including BITMAP and RECT), the structs below,
# or TYPE[N] arrays.

struct Enemy      int x, int y, int speedX, int speedY, BOOL movingRight, BOOL movingDown
struct Jewel      int x, int y, BOOL present
struct HighScore  char name[50], LONG score

# Startup and window
fn  1000:0010  WinMain
fn  1000:009c  RegisterMainClass
fn  1000:0106  CreateMainWindow
fn  1000:0872  RunDialog                 # MakeProcInstance + DialogBox + FreeProcInstance
fn  1000:08bc  PauseDlgProc
fn  1000:090a  WaitDlgProc               # closes itself after a 3 s timer

# Game flow
fn  1000:0964  NewGame
fn  1000:09f4  GameCompleted             # after level 14: ending message, high score, play again
fn  1000:0b38  IsInPlayfield
fn  1000:0b72  CursorHitsEnemy
fn  1000:0bda  FindJewelUnderCursor      # index, or -1
fn  1000:0c5c  LoadBitmapIntoDC
fn  1000:0ce0  SpawnEnemies
fn  1000:0dbb  DrawEnemies               # ROP 0x990066: same call erases and draws
fn  1000:0e17  MoveEnemies
fn  1000:0ee2  SpawnJewels
fn  1000:0f8c  DrawJewel                 # ROP 0x990066: same call erases and draws

